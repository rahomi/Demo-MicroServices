@Products_HostAddress = http://localhost:5024

### Get all products
GET {{Products_HostAddress}}/api/products
Accept: application/json

### Get product by ID
GET {{Products_HostAddress}}/api/products/11111111-1111-1111-1111-111111111111
Accept: application/json

### Create a new product
POST {{Products_HostAddress}}/api/products
Content-Type: application/json

{
  "name": "Webcam HD",
  "price": 59.99,
  "category": "Electronics"
}

### Update a product
PUT {{Products_HostAddress}}/api/products/11111111-1111-1111-1111-111111111111
Content-Type: application/json

{
  "id": "11111111-1111-1111-1111-111111111111",
  "name": "Wireless Mouse Pro",
  "price": 34.99,
  "category": "Electronics"
}

### Delete a product
DELETE {{Products_HostAddress}}/api/products/55555555-5555-5555-5555-555555555555
